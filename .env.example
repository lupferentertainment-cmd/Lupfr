# Resend – contact form and newsletter emails
# Get your API key at https://resend.com/api-keys
# Copy this file to .env.local and set your real key
RESEND_API_KEY=re_xxxxxxxxx

# Google Apps Script webhook URL for phone list signup (/api/phone-list)
# Must accept unauthenticated JSON POST requests and append to your sheet.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-web-app-id/exec
# If your script validates a shared key, set this (default JSON key "secret" on the webhook body).
# GOOGLE_SHEETS_SECRET=
# GOOGLE_SHEETS_SECRET_FIELD=secret

# Newsletter internal notification recipient (default: will@lupfr.com). Contact form always uses will@lupfr.com.
# RESEND_TO_EMAIL=will@lupfr.com

# Operator admin portal (/admin and admin.lupfr.com) — never commit real values
# ADMIN_USERNAME=will@lupfr.com
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=   # ≥32 random bytes (UTF-8); required with ADMIN_PASSWORD
# Browser URL for the phone-list / contacts Google Sheet (dashboard CTA). Not the webhook URL.
# ADMIN_CONTACTS_SHEET_URL=https://docs.google.com/spreadsheets/d/...
