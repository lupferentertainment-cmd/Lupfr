{
  "name": "lupfr",
  "version": "1.7.2",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun scripts/prepare-dev-cache.mjs && bunx --bun next dev --webpack",
    "start": "bun run _build && bun run _serve",
    "test": "bash scripts/ci.sh ci",
    "smoke": "bash scripts/ci.sh verify",
    "ship:dev": "bash scripts/ship-dev.sh",
    "promote:prod": "bash scripts/promote-prod.sh",
    "prepare": "bun scripts/install-pre-commit.js",
    "ci": "bun run test",
    "_generate-data": "bun scripts/generate-data.js",
    "_build": "bun run _generate-data && bun run _typecheck && bun scripts/clean-next-dist.mjs && bunx --bun next build --webpack",
    "_serve": "bunx --bun next start",
    "_lint": "bunx eslint .",
    "_typecheck": "bunx tsc --noEmit",
    "_test:smoke": "bunx vitest run --reporter=dot tests/unit/test-suite-gate.test.ts tests/unit/site.test.ts tests/unit/links.test.ts tests/unit/data-integrity.test.ts",
    "_coverage": "bunx vitest run --coverage --reporter=dot",
    "_verify:routes": "bash scripts/verify-routes.sh",
    "_verify:console": "bun scripts/verify-console.mjs",
    "_verify:client-bundle": "bun scripts/verify-client-bundle.mjs",
    "_images:optimize": "bun scripts/optimize-public-raster.mjs",
    "_vercel:env:check": "bash scripts/vercel-env-check.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
