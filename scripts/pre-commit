#!/bin/sh
# Pre-commit: canonical full test gate.
# Install: "bun install" / "bun run prepare" copies this to .git/hooks/pre-commit.
# Run manually anytime: bun run test

set -e
cd "$(git rev-parse --show-toplevel)"

echo "Pre-commit: canonical full test suite (bun run test)..."
bun run test || {
  echo "Pre-commit failed. Fix errors above, or run: bun run test"
  exit 1
}

echo "Pre-commit passed."
