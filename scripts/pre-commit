#!/bin/sh
# Pre-commit: same checks as CI — lint, production build, route smoke (verify-routes).
# Install: "bun install" / "bun run prepare" copies this to .git/hooks/pre-commit.
# Run manually anytime: bun run precommit

set -e
cd "$(git rev-parse --show-toplevel)"

echo "Pre-commit: lint + build + route smoke (see package.json \"verify\")..."
bun run verify || {
  echo "Pre-commit failed. Fix errors above, or run: bun run verify"
  exit 1
}

echo "Pre-commit passed."
