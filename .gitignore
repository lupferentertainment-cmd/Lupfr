# Common ignores
node_modules/
*.tsbuildinfo
# All Next build outputs, incl. isolated NEXT_DIST_DIR runs (.next-ci, .next-spacing, ...).
# Must stay gitignored or Tailwind v4's auto content scan crawls compiled chunks
# and can emit garbage utility classes that break the CSS build.
.next*/

# Bun-only: foreign lockfiles corrupt the React/Next module tree (see scripts/only-bun.mjs)
pnpm-lock.yaml
package-lock.json
yarn.lock

coverage/
.env*.local
.DS_Store
.vercel
.tmp-vercel-v0/

